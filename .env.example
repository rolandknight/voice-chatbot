# Secrets only. Non-secret config lives in config.yaml (committed, edit there).
# Copy this file to .env and fill in the keys you need.

# Claude cloud backend, reachable via the ask_claude skill ("ask Claude...",
# "switch to Claude"). Without this, ask_claude is unavailable and all turns
# stay on the local Ollama model. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: route Claude through a gateway or proxy instead of Anthropic
# directly. Empty (the default) uses https://api.anthropic.com/v1/messages.
# ANTHROPIC_BASE_URL=

# Spotify Web API (play_spotify, play_spotify_playlist, etc.). PKCE flow,
# so the secret is optional. Create an app at:
#   https://developer.spotify.com/dashboard
# The Redirect URI in the dashboard MUST match skills.spotify.redirect_uri
# in config.yaml exactly (defaults to http://127.0.0.1:8765/callback).
# After setting these, run: python scripts/spotify.py --bootstrap
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Web search providers. brave is the default WEB_SEARCH_PROVIDER, so
# BRAVE_API_KEY is required and the server refuses to start without it (free
# tier at https://brave.com/search/api/). To run with no key at all, set
# WEB_SEARCH_PROVIDER=duckduckgo below — but its Instant Answer API returns
# nothing for most real questions. TAVILY_API_KEY is needed only for
# WEB_SEARCH_PROVIDER=tavily.
BRAVE_API_KEY=
TAVILY_API_KEY=

# Chatterbox-TTS-Server. Defaults to "not-needed" for the local server.
# Override only if you've put the server behind auth.
# CHATTERBOX_API_KEY=

# Hugging Face token. Required to download gated models like Stable Audio
# Open 1.0 (skills.sfx.sao_enabled = true). Accept the model terms first:
#   https://huggingface.co/stabilityai/stable-audio-open-1.0
HF_TOKEN=


# =====================================================================
# voice-chatbot-server (Rust) settings. Moved here from poc/.env.example when
# the PoC trees were archived (archive/poc).
# =====================================================================
# Copy to poc/.env and fill in. poc/.env is gitignored; never commit real keys.
OPENROUTER_API_KEY=

# LLM. Two providers (ADR-0007):
#  - ollama (local, default when OPENROUTER_BASE_URL points at :11434): the
#    chatbot owns the lifecycle — spawns `ollama serve` if nothing answers,
#    pulls the model, warms the exact prompt prefix, pins it resident via the
#    native /api/chat (keep_alive/num_ctx on every request), and unloads it on
#    exit. No OPENROUTER_API_KEY needed.
#  - openrouter (cloud): OpenAI-compatible; needs the key.
#   OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=gemma4:26b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER=ollama            # or openrouter; inferred from the base URL
# LLM_NUM_CTX=8192               # context on every request and for a spawned serve
# OLLAMA_SUPERVISE=auto          # auto: spawn if nothing answers | never | always
# OLLAMA_BIN=ollama
# OLLAMA_HOST=127.0.0.1         # bind address for a spawned serve; 0.0.0.0 shares the model over the LAN (no auth!)
# OLLAMA_UNLOAD_ON_EXIT=true     # false keeps the model loaded across chatbot restarts (dev)
# OLLAMA_KEEPWARM_SECS=60        # idle keep-warm ping; absorbs Ollama's idle-time evict+reload off the user's turn (0 = off)

# Cross-platform validation profile: cloud Haiku LLM + local cloned voice.
# Keep values unquoted; both Bash and the pytest loader read this file.
LLM_MODEL=anthropic/claude-haiku-4.5
TTS_BACKEND=chatterbox
CHATTERBOX_URL=http://127.0.0.1:8004
CHATTERBOX_VOICE=marvin.wav
# `qwen`: Qwen3-TTS streamed in-process (poc-qwen-streaming's PyO3 mlx-audio
# engine; Apple Silicon). Needs `TTS_BACKEND=qwen make build` (links
# poc-qwen's venv). Kokoro builds carry none of it. Voice = a preset in
# voices/ with a .txt transcript; size 1.7B (default) or 0.6B (faster, ~0.12 s
# to first chunk); interval = seconds of audio per streamed chunk.
# QWEN_VOICE=babel             # default voice; every preset in voices/ (babel, marvin, one-one) is loaded
# QWEN_SIZE=1.7B               # 1.7B (default, best quality) or 0.6B (faster first chunk)
# QWEN_INTERVAL_S=0.32
# QWEN_CONFIG=/absolute/path/to/poc-qwen-streaming/config.flowcat.yaml
# Optional override. `make poc-up` generates the default cached Ready greeting.
# GREETING_WAV=/absolute/path/to/ready-24khz-mono-s16.wav

# Select one local STT implementation. `whisper` remains the default and emits
# only the final utterance; `moonshine` and `nemotron` stream display-only
# interim text while you speak. All three run locally.
STT_BACKEND=whisper

# Whisper and Silero default to the models downloaded by `make poc-setup`.
# WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
# The 8C/16T laptop profile uses its physical cores while Chatterbox owns the GPU.
WHISPER_THREADS=8
# Moonshine is optional: run `./scripts/setup_moonshine.sh` before building with
# the `moonshine` Cargo feature. The default model directory is:
#   poc/models/moonshine/download.moonshine.ai/model/medium-streaming-en/quantized_26_07_30
# MOONSHINE_MODEL=/absolute/path/to/quantized_26_07_30
# Display-only streaming hypothesis cadence; the native cache floor is 200 ms.
MOONSHINE_UPDATE_INTERVAL_MS=250
# Optional comma-separated contextual spelling bias, kept short for accuracy.
# MOONSHINE_KEYTERMS=BBC Radio 4,Purple Rain,Prince
# NVIDIA Nemotron is optional: run `./scripts/setup_nemotron.sh`. `nemotron`
# runs the model in-process through NeMo-Speech.cpp's C library (no sidecar,
# no session limit); `nemotron-sidecar` keeps the localhost WebSocket server
# started by `make up`. `auto` chooses CUDA on Linux/NVIDIA, Metal on Apple
# Silicon, and CPU otherwise.
# NEMOTRON_MODEL=/absolute/path/to/nemotron-speech-streaming-en-0.6b.q8_0.gguf
NEMOTRON_URL=http://127.0.0.1:8178
NEMOTRON_DEVICE=auto
# Native cache window: 0/1/6/13 right-context frames correspond to
# 80/160/560/1120 ms. Six is the accuracy/latency default.
NEMOTRON_RIGHT_CONTEXT=6
# Optional comma-separated RNNT word/phrase boosting. NeMo-Speech.cpp accepts
# this field, but the pinned published Q8 currently lacks the tokenizer data
# needed to apply it; leave empty until NVIDIA updates that artifact.
# Recognizer biasing: proper nouns that have to come through verbatim, because a
# skill keys off them — 'Claude' for ask_claude, the persona names for
# switch_persona and the wake heads — plus whatever you play often.
# NEMOTRON_SPEECH_CONTEXTS=Claude,Babel,Marvin,One One,BBC Radio 4,Purple Rain
# VAD_MODEL=/absolute/path/to/silero_vad.onnx
# Match the Python chatbot's `wake.vad_stop_secs` turn endpoint.
VAD_STOP_SECS=0.2

# Listen mode (server-side wake words). WAKE_DIR loads every *.onnx head in
# the directory; each selects the persona named by its file (hey_babel -> babel,
# hey_one_one -> one-one, a Qwen preset in voices/, preloaded automatically).
# Unset = push mode. WAKE_MODEL=<one .onnx> is the single-head form.
# The native client reads WAKE_DIR, WAKE_THRESHOLD and WAKE_SESSION_SECS from
# here too, for its own on-device detection; WAKE_MODEL and WAKE_GRACE_SECS are
# the server's alone.
# WAKE_DIR=models/wakeword
# WAKE_THRESHOLD=0.5            # per-head probability threshold
# WAKE_SESSION_SECS=15          # silence that ends a wake session
# WAKE_GRACE_SECS=0.8           # hold the wake phrase's end-of-speech this long for the command to follow (0 = off)

# The native client (crates/client) reads this same file when run from the repo
# root. Flags still win: `make call SERVER_URL=...` beats anything set here.
# SERVER_URL=http://127.0.0.1:6210   # the server the client dials
# INPUT_DEVICE=Jabra                 # unset = the Jabra when plugged in, else the OS default
# OUTPUT_DEVICE=Jabra
# NO_WAKE=true                       # always-on push mode, no on-device wake words
# LOG_LEVEL=info                     # tracing filter for both binaries

# Remote callers (the native client on another machine, a browser on the LAN):
# bind the HTTP/WS server on the LAN and, if needed, pin the advertised ICE
# host address (default: the interface that routes back to each caller).
# BIND=0.0.0.0:6210
# ADVERTISE_IP=192.168.0.115
# Browsers expose the microphone only on secure origins (https or localhost):
# add an HTTPS listener with the repo's self-signed dev cert (make tls-cert),
# or just use `make up-lan`, then open https://<server-lan-ip>:6443 and accept
# the certificate warning. The plain listener keeps serving the harness.
# TLS_BIND=0.0.0.0:6443
# TLS_CERT=../.certs/cert.pem
# TLS_KEY=../.certs/key.pem

# Skills run inside the server (crates/server/src/skills; see
# docs/plans/skills-in-server.md). Secrets shared with the Python chatbot
# (SPOTIPY_CLIENT_ID, ANTHROPIC_API_KEY, BRAVE_API_KEY, TAVILY_API_KEY) are read
# from the repo-root .env as well; values here win when set in both.
# WEATHER_DEFAULT_LOCATION=      # e.g. "Brooklyn, NY"; empty = CoreLocation/IP lookup
# Web search. brave is the default and needs a key (free tier at
# https://brave.com/search/api/); duckduckgo needs none but its Instant Answer
# API returns nothing for most real questions; tavily needs TAVILY_API_KEY.
# WEB_SEARCH_PROVIDER=brave
# Where the household is: city,region,ISO-3166-1-alpha-2,IANA-timezone.
# Feeds Claude's server-side web search and Brave's country filter.
# SEARCH_LOCATION=Toronto,Ontario,CA,America/Toronto
# Anthropic's server-side web search on the Claude turns ($10 per 1,000
# searches plus tokens). CLAUDE_SEARCH_TOOL=web_search_20250305 is the faster
# path for models older than Opus 4.6.
# CLAUDE_WEB_SEARCH=true
# CLAUDE_SEARCH_TOOL=web_search_20260209
# CLAUDE_SEARCH_MAX_USES=3
# SKILLS_RADIO=on                # BBC live radio (plays on the native client via mpv)
# SKILLS_SHOWS=on                # BBC Sounds shows/podcasts (server needs yt-dlp for the fallback)
# SKILLS_SPOTIFY=on              # also needs SPOTIPY_CLIENT_ID + `voice-chatbot-server spotify-login`
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8765/callback
# SKILLS_SFX=on                  # generate_sound_effect; generators via `make sfx-up`
# SFX_WOOSH_URL=http://127.0.0.1:8005
# SFX_SAO_URL=http://127.0.0.1:8006
# SFX_BACKEND=auto               # auto (keyword route) | woosh | stable_audio
# QWEN_VOICES=                   # no longer needed: all voices/ presets load and are wake/switch_persona targets
# CLAUDE_MODEL=claude-opus-5     # ask_claude model (needs ANTHROPIC_API_KEY)
# CLAUDE_EFFORT=low              # output_config.effort: low|medium|high|xhigh|max; empty omits it
