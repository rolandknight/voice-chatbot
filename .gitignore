.venv/
.env
__pycache__/
*.pyc
.hermit/

# Chatterbox-TTS-Server clone, its venv, and any model caches it pulls.
# (Anchored to the repo root: archive/poc/vendor/ holds a committed
# flowcat-core patch and must NOT be ignored.)
/vendor/

# Reference clips for cloned personas. Keep these out of git unless you
# explicitly want to commit them (small files only — and check licensing).
#voices/*.wav
#voices/*.mp3
#voices/*.flac

scripts/microwakeword/_work/
scripts/wakeword/_work/

# Server runtime artifacts: downloaded STT/VAD models (the trained wake heads
# in models/wakeword ARE committed), native libs, process logs. fixtures/*.wav
# ARE committed.
/models/*
!/models/wakeword/
!/models/wakeword-archive/
/logs/
/.deps/
# Archived PoC trees (archive/): their models, logs, venvs and build output.
archive/poc/models/
archive/poc/logs/
archive/poc/.deps/
archive/poc/.venv/
archive/**/target/

# Self-signed certs for the LAN dev servers (smoke + main backend).
.certs/
webrtc_smoke/.certs/
third_party/flowcat-core/target/

# CUDA toolkit installers. Multi-gigabyte vendor downloads, kept out of the
# tree so a stray `git add -A` cannot commit one. The toolkit itself installs
# outside the repo (see archive/poc-tts/.env for the CUDA_HOME pointer).
cuda_*.run

# Workspace build output (crates/server, crates/client).
/target/

# Python test/packaging droppings (crates/qwen-tts/python).
.pytest_cache/
*.egg-info/
/wakeword/_work/