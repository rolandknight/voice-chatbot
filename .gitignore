.venv/
.env
__pycache__/
*.pyc
.hermit/

# Chatterbox-TTS-Server clone, its venv, and any model caches it pulls.
# (Anchored to the repo root: poc/vendor/ holds the committed flowcat-core
# patch and must NOT be ignored.)
/vendor/

# Reference clips for cloned personas. Keep these out of git unless you
# explicitly want to commit them (small files only — and check licensing).
#voices/*.wav
#voices/*.mp3
#voices/*.flac

scripts/microwakeword/_work/
scripts/wakeword/_work/

# PoC runtime artifacts (docs/poc/flowcat-poc-plan.md): downloaded models,
# process logs, Rust build output. Fixtures (poc/harness/fixtures/*.wav) ARE
# committed.
poc/models/
poc/logs/
poc/flowcat/target/
poc/flowcat-client/target/
poc/.deps/

# Self-signed certs for the LAN dev servers (smoke + main backend).
.certs/
webrtc_smoke/.certs/
poc/vendor/flowcat-core/target/
poc/vendor/oww_rs/**/target/

# CUDA toolkit installers. Multi-gigabyte vendor downloads, kept out of the
# tree so a stray `git add -A` cannot commit one. The toolkit itself installs
# outside the repo (see poc-tts/.env for the CUDA_HOME pointer).
cuda_*.run

# Workspace build output (crates/server, crates/client).
/target/

# Python test/packaging droppings (crates/qwen-tts/python).
.pytest_cache/
*.egg-info/
