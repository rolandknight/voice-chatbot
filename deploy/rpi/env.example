# Config for the native client on a Pi. install.sh copies this to
# <install-dir>/.env on a first install and never touches it again; the client
# loads it itself, relative to its working directory.
#
# This is NOT a copy of the repo-root .env. That file carries the server's API
# keys and model settings, none of which a satellite has any business holding.
# The names below are all the client reads.

# Where the server lives. The built-in default is http://127.0.0.1:6210, which
# on a Pi is almost always wrong -- the server is another box on the LAN.
SERVER_URL=http://192.168.0.245:6210

# Audio devices. Left unset, the client takes the Jabra speakerphone when one
# is plugged in and the system default otherwise, which is what you want on a
# Pi with a single USB speakerphone. Name one (INPUT_DEVICE=Jabra), pick it by
# index, or force the system default (INPUT_DEVICE=default) to override.
#INPUT_DEVICE=
#OUTPUT_DEVICE=

# On-device wake words: a directory of hey_<persona>.onnx heads, relative to
# the working directory. `make deploy-pi` syncs models/wakeword for this.
#WAKE_DIR=models/wakeword
#WAKE_THRESHOLD=0.5
#WAKE_SESSION_SECS=15

# Always-on push mode instead of wake words. Set WAKE_DIR or NO_WAKE, never
# both: they conflict, and the client refuses to start with both set.
#NO_WAKE=true

#LOG_LEVEL=info
