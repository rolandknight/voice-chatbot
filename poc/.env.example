# Copy to poc/.env and fill in. poc/.env is gitignored; never commit real keys.
OPENROUTER_API_KEY=

# LLM. Two providers (ADR-0007):
#  - ollama (local, default when OPENROUTER_BASE_URL points at :11434): the
#    chatbot owns the lifecycle — spawns `ollama serve` if nothing answers,
#    pulls the model, warms the exact prompt prefix, pins it resident via the
#    native /api/chat (keep_alive/num_ctx on every request), and unloads it on
#    exit. No OPENROUTER_API_KEY needed.
#  - openrouter (cloud): OpenAI-compatible; needs the key.
#   OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
#   POC_LLM_MODEL=gemma4:26b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# POC_LLM_PROVIDER=ollama            # or openrouter; inferred from the base URL
# POC_LLM_NUM_CTX=8192               # context on every request and for a spawned serve
# POC_OLLAMA_SUPERVISE=auto          # auto: spawn if nothing answers | never | always
# POC_OLLAMA_BIN=ollama
# POC_OLLAMA_UNLOAD_ON_EXIT=true     # false keeps the model loaded across chatbot restarts (dev)

# Cross-platform validation profile: cloud Haiku LLM + local cloned voice.
# Keep values unquoted; both Bash and the pytest loader read this file.
POC_LLM_MODEL=anthropic/claude-haiku-4.5
POC_TTS_BACKEND=chatterbox
POC_CHATTERBOX_URL=http://127.0.0.1:8004
POC_CHATTERBOX_VOICE=marvin.wav
# `qwen`: Qwen3-TTS streamed in-process (poc-qwen-streaming's PyO3 mlx-audio
# engine; Apple Silicon). Needs `POC_TTS_BACKEND=qwen make build` (links
# poc-qwen's venv). Kokoro builds carry none of it. Voice = a preset in
# voices/ with a .txt transcript; size 1.7B (default) or 0.6B (faster, ~0.12 s
# to first chunk); interval = seconds of audio per streamed chunk.
# POC_QWEN_VOICE=babel             # a preset in voices/ (babel, marvin, one-one)
# POC_QWEN_SIZE=1.7B               # 1.7B (default, best quality) or 0.6B (faster first chunk)
# POC_QWEN_INTERVAL_S=0.32
# POC_QWEN_CONFIG=/absolute/path/to/poc-qwen-streaming/config.flowcat.yaml
# Optional override. `make poc-up` generates the default cached Ready greeting.
# POC_GREETING_WAV=/absolute/path/to/ready-24khz-mono-s16.wav

# Select one local STT implementation. `whisper` remains the default and emits
# only the final utterance; `moonshine` and `nemotron` stream display-only
# interim text while you speak. All three run locally.
POC_STT_BACKEND=whisper

# Whisper and Silero default to the models downloaded by `make poc-setup`.
# POC_WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
# The 8C/16T laptop profile uses its physical cores while Chatterbox owns the GPU.
POC_WHISPER_THREADS=8
# Moonshine is optional: run `./scripts/setup_moonshine.sh` before building with
# the `moonshine` Cargo feature. The default model directory is:
#   poc/models/moonshine/download.moonshine.ai/model/medium-streaming-en/quantized_26_07_30
# POC_MOONSHINE_MODEL=/absolute/path/to/quantized_26_07_30
# Display-only streaming hypothesis cadence; the native cache floor is 200 ms.
POC_MOONSHINE_UPDATE_INTERVAL_MS=250
# Optional comma-separated contextual spelling bias, kept short for accuracy.
# POC_MOONSHINE_KEYTERMS=BBC Radio 4,Purple Rain,Prince
# NVIDIA Nemotron is optional: run `./scripts/setup_nemotron.sh`. `nemotron`
# runs the model in-process through NeMo-Speech.cpp's C library (no sidecar,
# no session limit); `nemotron-sidecar` keeps the localhost WebSocket server
# started by `make up`. `auto` chooses CUDA on Linux/NVIDIA, Metal on Apple
# Silicon, and CPU otherwise.
# POC_NEMOTRON_MODEL=/absolute/path/to/nemotron-speech-streaming-en-0.6b.q8_0.gguf
POC_NEMOTRON_URL=http://127.0.0.1:8178
POC_NEMOTRON_DEVICE=auto
# Native cache window: 0/1/6/13 right-context frames correspond to
# 80/160/560/1120 ms. Six is the accuracy/latency default.
POC_NEMOTRON_RIGHT_CONTEXT=6
# Optional comma-separated RNNT word/phrase boosting. NeMo-Speech.cpp accepts
# this field, but the pinned published Q8 currently lacks the tokenizer data
# needed to apply it; leave empty until NVIDIA updates that artifact.
# POC_NEMOTRON_SPEECH_CONTEXTS=BBC Radio 4,Purple Rain,Prince
# POC_VAD_MODEL=/absolute/path/to/silero_vad.onnx
# Match the Python chatbot's `wake.vad_stop_secs` turn endpoint.
POC_VAD_STOP_SECS=0.2

# Remote callers (the native client on another machine, a browser on the LAN):
# bind the HTTP/WS server on the LAN and, if needed, pin the advertised ICE
# host address (default: the interface that routes back to each caller).
# POC_BIND=0.0.0.0:6210
# POC_ADVERTISE_IP=192.168.0.115
# Browsers expose the microphone only on secure origins (https or localhost):
# add an HTTPS listener with the repo's self-signed dev cert (make tls-cert),
# or just use `make up-lan`, then open https://<server-lan-ip>:6443 and accept
# the certificate warning. The plain listener keeps serving the harness.
# POC_TLS_BIND=0.0.0.0:6443
# POC_TLS_CERT=../.certs/cert.pem
# POC_TLS_KEY=../.certs/key.pem
